NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55421
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001

# Server only. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
JDOODLE_CLIENT_ID=
JDOODLE_CLIENT_SECRET=
JDOODLE_JAVA_VERSION_INDEX=
# Keep false until the operator confirms finite provider-side compilation,
# runtime, memory/output bounds and sandbox isolation for this exact plan.
JDOODLE_LIMITS_CONFIRMED=false
JUDGE_DAILY_LIMIT=20
JUDGE_MAX_CONCURRENCY=4
JUDGE_RESERVATION_SECONDS=45
JUDGE_REQUEST_TIMEOUT_MS=15000
