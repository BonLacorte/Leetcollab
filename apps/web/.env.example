NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55421
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001

# Server only. Never prefix these with NEXT_PUBLIC_.
# Optional server-to-server realtime URL; defaults to NEXT_PUBLIC_SOCKET_URL.
# Use HTTPS outside loopback. Requires the judge participation endpoints.
REALTIME_INTERNAL_URL=
# Server-only secret shared by the web and realtime services for Submit capture.
REALTIME_JUDGE_SHARED_SECRET=
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
# Server-owned selection: disabled, jdoodle, or onlinecompiler. No automatic fallback.
# Existing deployments without this selector retain their JDoodle configuration.
JUDGE_PROVIDER=disabled
JDOODLE_CLIENT_ID=
JDOODLE_CLIENT_SECRET=
JDOODLE_JAVA_VERSION_INDEX=
# Keep false until the operator confirms finite provider-side compilation,
# runtime, memory/output bounds and sandbox isolation for this exact plan.
JDOODLE_LIMITS_CONFIRMED=false
# Keep both false until a separately authorized release. Policy acceptance adopts
# the OnlineCompiler-specific isolation/limits and residual gaps documented in
# docs/onlinecompiler-integration.md. It does not authorize runtime activation.
ONLINECOMPILER_API_KEY=
ONLINECOMPILER_EXECUTION_APPROVED=false
ONLINECOMPILER_POLICY_ACCEPTED=false
# Legacy ONLINECOMPILER_LIMITS_CONFIRMED is ignored and cannot enable execution.
# Server-only access mode. Missing mode retains normal authenticated access;
# unknown/empty modes deny. Evaluation is closed unless every field below is valid.
# Normal access is NOT authorized by a tester-only evaluation.
JUDGE_ACCESS_MODE=normal
# To select evaluation: JUDGE_ACCESS_MODE=evaluation, JUDGE_PROVIDER=onlinecompiler.
# Supply verified tester/problem UUIDs and UTC ISO instants (Z, seconds required).
JUDGE_EVALUATION_USER_ID=
JUDGE_EVALUATION_PROBLEM_ID=
# Pin the quota period's 23:55 UTC start; window <=10m, expires <=reset minus 2m.
JUDGE_EVALUATION_PERIOD_START=
JUDGE_EVALUATION_STARTS_AT=
JUDGE_EVALUATION_EXPIRES_AT=
# Read-only shared used baseline U (0..18). Evaluation REQUIRES an explicit daily
# limit U+2 (<=20), concurrency 1, reservation 45s and timeout 15000ms below.
JUDGE_EVALUATION_BASELINE_USED=
JUDGE_DAILY_LIMIT=25
# Local development only: opt in with a loopback Supabase URL and OnlineCompiler.
# Requires the separately applied supabase/local/enable-test-quota.sql script.
# Production normal access is capped at 25; restricted evaluation remains at 20.
JUDGE_LOCAL_TESTING=false
JUDGE_MAX_CONCURRENCY=4
JUDGE_RESERVATION_SECONDS=45
JUDGE_REQUEST_TIMEOUT_MS=15000
